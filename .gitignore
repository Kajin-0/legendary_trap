# Tracked source transport
# Original MP3s under source/ are intentionally committed so GitHub can transport them to the VPS.
*.zip

# Canonical runtime audio remains local/untracked
input/audio/*
!input/audio/.gitkeep

# Other audio formats are runtime-only unless explicitly added under source/
*.wav
*.flac
*.m4a

# Generated intermediates and outputs
work/*
!work/.gitkeep
output/*
!output/.gitkeep

# Model/runtime caches
models/
.cache/
huggingface/
torch/
*.pt
*.pth
*.ckpt
*.safetensors

# Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local environment
.env
.env.*
!.env.example

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
