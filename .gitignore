# Tracked source transport
# Original MP3s under source/ are intentionally committed so GitHub can transport them to the VPS.
*.zip

# Canonical runtime audio remains local/untracked
input/audio/*
!input/audio/.gitkeep

# Other audio formats are runtime-only unless explicitly added under source/
*.wav
*.flac
*.m4a

# Generated intermediates and outputs
work/*
!work/.gitkeep
output/*
!output/.gitkeep
reports/apple_experiments/*/timing.json
reports/*_experiments/*/timing.json

# Model/runtime caches
models/
.ffmpeg/
tools/
tools/ffmpeg-*/
tools/ffmpeg-static.tar.xz
.cache/
huggingface/
torch/
*.pt
*.pth
*.ckpt
*.safetensors

# Python
.venv/
venv/
__pycache__/
*.egg-info/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local environment
.env
.env.*
!.env.example

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local third-party compatibility checkout and model; never commit the upstream binary.
third_party/lyrics-aligner/
.venv-lyrics-aligner/
.envs/lyrics-aligner/
